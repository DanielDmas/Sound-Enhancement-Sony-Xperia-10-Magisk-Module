#!/system/bin/sh
# Use Magisk's documented applets even from an ADB/terminal shell.
if [ -x /data/adb/magisk/busybox ] && [ "${SEFX_SHELL:-}" != magisk_busybox ]; then
    export SEFX_SHELL=magisk_busybox ASH_STANDALONE=1
    exec /data/adb/magisk/busybox sh "$0" "$@"
fi
SEFX_SELF=$(readlink -f "$0")
MODDIR=${SEFX_SELF%/system/bin/sefx}
[ -f "$MODDIR/sefx/lib.sh" ] || MODDIR=/data/adb/modules/SoundEnhancement
[ -f "$MODDIR/sefx/lib.sh" ] || { printf 'Module files missing.\n' >&2; exit 3; }
. "$MODDIR/sefx/lib.sh"
sefx_init || exit $?
trap 'sefx_cleanup' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
case "${1:-open}" in
    open) sefx_sync manual || exit $?; sefx_panel "${2:-}" || exit $?; sefx_start_watch ;;
    attach) sefx_sync manual ;;
    sync) sefx_sync auto ;;
    refresh) sefx_sync repair ;;
    status) sefx_status ;;
    doctor) sefx_diagnostics private ;;
    report) sefx_diagnostics export ;;
    auto) sefx_auto "${2:-}" ;;
    watch) sefx_watch ;;
    help|-h|--help)
        printf '%s\n' 'sefx            Attach to active media and open Sony settings' \
            'sefx open PKG   Select one active player when several are playing' \
            'sefx attach     Reattach without opening settings' \
            'sefx refresh    Close/reopen managed sessions; preserve presets' \
            'sefx status     Show watcher and current session evidence' \
            'sefx auto on    Enable automatic reconnection' \
            'sefx auto off   Stop automatic reconnection' \
            'sefx doctor     Save a private diagnostic report' \
            'sefx report     Export diagnostics to Downloads' ;;
    *) printf 'Unknown command. Run: sefx help\n' >&2; exit 2 ;;
esac
